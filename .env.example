# Basic project settings
COMPOSE_PROJECT_NAME=monitoring-platform
TZ=Asia/Shanghai

# Grafana initial administrator account.
# Copy this file to .env and change the password before production use.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_PASSWORD

# Local demo HTTP service exposed on the host.
DEMO_HTTP_PORT=8080

# Optional metadata used by scripts and documents.
SERVER_IP=YOUR_SERVER_IP

# Image overrides for networks where Docker Hub or gcr.io is unstable.
# Keep defaults for normal environments. On China mainland ECS, configure Docker
# registry mirrors first; if gcr.io is still blocked, override CADVISOR_IMAGE
# with an image that you have mirrored into your own Alibaba Cloud ACR namespace.
PROMETHEUS_IMAGE=prom/prometheus:v2.53.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
GRAFANA_IMAGE=grafana/grafana:11.1.4
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.25.0
NGINX_IMAGE=nginx:1.27-alpine
